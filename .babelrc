{
  "presets": ["next/babel"],
  "plugins": [
    [
      "module-resolver",
      {
        "root": ["./"],
        "alias": {
          "@API": "./src/Api",
          "@Components": "./src/Components",
          "@Pages": "./pages",
          "@Reducers": "./src/Redux/Reducers",
          "@Redux": "./src/Redux",
          "@Services": "./src/Services",
          "@Static": "./public/static"
        }
      }
    ]
  ]
}
